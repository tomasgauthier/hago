# Google AI (Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI (optional)
OPENAI_API_KEY=your_openai_key_here

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Telegram Bot Token
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTHORIZED_USERS=123456789

# Data Directory
DATA_DIR=./data

# Obsidian
OBSIDIAN_VAULT_PATH=C:\path\to\your\vault

# Admin password (REQUIRED for HTTP API access)
ADMIN_PASSWORD=your_strong_password_here

# Server binding
SERVER_HOST=127.0.0.1
SERVER_PORT=3331

# Web search (Brave Search API)
# Get your API key from https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Per-session token budget (default: 50000)
SESSION_TOKEN_BUDGET=50000

# Daily cost ceiling in USD (default: 5.00) — stops all LLM calls when reached
DAILY_COST_CEILING=5.00

# WhatsApp auth encryption key (32 hex bytes = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_AUTH_ENCRYPTION_KEY=your_64_char_hex_key_here
